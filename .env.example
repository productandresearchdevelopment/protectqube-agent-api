# ==============================================================================
# Backend Environment Configuration Template
# Duplicate this file as '.env' in the backend directory and adjust values.
# ==============================================================================

# Server Configuration
PROJECT_NAME="ProtectQube AIOps Gateway"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Security
# WARNING: Change this SECRET_KEY to a secure random string in production!
# e.g., generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/agent_pqube

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smartbox-agent-01
MQTT_TOPIC_TELEMETRY=pqube/nms/gw-3a53d2ff
MQTT_PUBLISH_INTERVAL_SECONDS=30

# Hardware & Agent Settings
# Gateway Type: 1 = SmartBox Hitam (Raspberry Pi 3B+), 2 = SmartBox Putih (Rockchip RK3328)
GATEWAY_TYPE=1
GATEWAY_ID=smartbox-gateway-01
MODEM_SERIAL_PORT=/dev/ttyUSB2
MODEM_BAUDRATE=115200
DVR_HOST=192.168.1.100
DVR_PORT=80
DVR_RTSP_PORT=554
